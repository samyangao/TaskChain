# Copy this file to .env and fill in your own local PostgreSQL credentials.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ias_auth_demo
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# REQUIRED. Must be at least 32 random characters - the app refuses to start
# with a missing, placeholder, or short value, because a known Flask secret key
# lets an attacker forge any session cookie.
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=0

# Development only. Setting this to 1 enables the Werkzeug debugger, which allows
# arbitrary code execution. Never enable it on a shared or deployed machine.
FLASK_DEBUG=0

# Bind address for the dev server. Keep 127.0.0.1 unless you intend to expose it.
HOST=127.0.0.1
PORT=5000

# Activity 2 classroom lab. The unprotected /api/lab-login and the password
# brute-force tester are DISABLED unless this is explicitly set to 1.
ENABLE_LAB=0

# ---------------------------------------------------------------------------
# IT 107 security module
# ---------------------------------------------------------------------------

# AES-256-GCM key for the sensitive registration field (Contact Number).
# 32 random bytes, base64 or hex. Keep this out of Git.
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FIELD_ENCRYPTION_KEY=replace_with_32_random_bytes_base64

# Local fallback while SMTP is not configured: 1 writes OTP emails to
# logs/mail_outbox.log (outside the web root). Set to 0 on demo day.
MAIL_DEV_MODE=1

# Gmail SMTP. Turn on 2-Step Verification, then create an App Password.
# Your normal Gmail password will NOT work.
# Easiest setup: run  python scripts/smtp_check.py --email you@gmail.com
# It tests the login, sends one test email, and only then writes these values
# (and MAIL_DEV_MODE=0) to .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
SMTP_FROM=your.address@gmail.com
SMTP_STARTTLS=1

# Public base URL used in alert emails (no trailing slash).
APP_BASE_URL=http://127.0.0.1:5000
