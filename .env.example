# Copy this file to .env and fill in your own local PostgreSQL credentials.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ias_auth_demo
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# REQUIRED. Must be at least 32 random characters - the app refuses to start
# with a missing, placeholder, or short value, because a known Flask secret key
# lets an attacker forge any session cookie.
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=0

# Development only. Setting this to 1 enables the Werkzeug debugger, which allows
# arbitrary code execution. Never enable it on a shared or deployed machine.
FLASK_DEBUG=0

# Bind address for the dev server. Keep 127.0.0.1 unless you intend to expose it.
HOST=127.0.0.1
PORT=5000

# Activity 2 classroom lab. The unprotected /api/lab-login and the password
# brute-force tester are DISABLED unless this is explicitly set to 1.
ENABLE_LAB=0
